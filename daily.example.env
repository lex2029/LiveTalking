# Daily REST API key (server-side only)
export DAILY_API_KEY=replace_me
# Daily domain, e.g. yourteam.daily.co
export DAILY_DOMAIN=yourteam.daily.co
# Room lifetime in seconds
export DAILY_ROOM_TTL=7200
# Meeting token lifetime in seconds
export DAILY_TOKEN_TTL=7200
# Daily SDK worker threads
export DAILY_WORKER_THREADS=4
# Quality automation (bot -> client hints)
export DAILY_QUALITY_AUTO=1
export DAILY_QUALITY_INTERVAL=2.0
export DAILY_QUALITY_GOOD_STREAK=8
export DAILY_QUALITY_WARN_STREAK=1
export DAILY_QUALITY_BAD_STREAK=2
# Audio pacing/backlog controls
export DAILY_AUDIO_QUEUE=200
export DAILY_AUDIO_MAX_BACKLOG=5
# Audio tuning (optional)
# Keep 16000 for best lip-sync stability (matches model/TTS pipeline).
export DAILY_AUDIO_RATE=16000
export DAILY_AUDIO_BITRATE=64000
# Video tuning (optional)
export DAILY_VIDEO_WIDTH=1920
export DAILY_VIDEO_HEIGHT=1080
export DAILY_VIDEO_FPS=25
export DAILY_VIDEO_QUALITY=high
export DAILY_VIDEO_CODEC=H264
